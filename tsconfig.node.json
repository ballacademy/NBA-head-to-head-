{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["vitest/globals"],
    "noEmit": true,
    // Tests typecheck app modules; hub prefetch dynamically imports .tsx pages.
    "jsx": "react-jsx"
  },
  "include": ["vite.config.ts", "src/**/*.test.ts"]
}
