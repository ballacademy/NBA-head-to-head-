# Always revalidate the HTML shell so deploys cannot leave browsers
# pointing at deleted Vite hashes.
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

# Social / messaging preview images — short TTL so redesigns propagate.
/og-share.png
  Cache-Control: public, max-age=3600
  Content-Type: image/png

/og-share-v2.png
  Cache-Control: public, max-age=3600
  Content-Type: image/png

/og-share-v3.png
  Cache-Control: public, max-age=3600
  Content-Type: image/png

# Versioned logo mark — long-cache is OK because the filename changes on redesign.
/draft-day-gm-logo-v4.png
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/png

# Legacy unversioned path — short TTL so old bookmarks pick up replacements.
/draft-day-gm-logo.png
  Cache-Control: public, max-age=3600
  Content-Type: image/png

# Only long-cache real hashed bundles — not /assets/404.html.
/assets/*.js
  Cache-Control: public, max-age=31536000, immutable

/assets/*.css
  Cache-Control: public, max-age=31536000, immutable

/assets/404.html
  Cache-Control: no-store
